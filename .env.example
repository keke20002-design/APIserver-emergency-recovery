# APIserver environment template
# Copy this file to .env and fill in the real values. Never commit .env.

USE_MOCK_DATA=false
API_BASE_URL=

# Google OAuth / Ads / AdMob / GA4
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
ADMOB_PUBLISHER_ID=
GA4_REFRESH_TOKEN=
# JSON array: [{"property_id":"...","app_id":"...","app_name":"..."}]
GA4_PROPERTIES=[]

# AI / search / media APIs
GEMINI_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
YOUTUBE_API_KEY=
PEXELS_API_KEY=
RIOT_API_KEY=
LOL_ESPORTS_API_KEY=
API_FOOTBALL_KEY=

# Korean public-data APIs
DAEJEON_API_KEY=
SEOUL_API_KEY=
DATA_GO_KR_SERVICE_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# WordPress / publishing
WORDPRESS_URL=
WORDPRESS_INTERNAL_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=
BLOG_ADMIN_ID=
BLOG_ADMIN_PW=
INDEXNOW_KEY=
ADSENSE_PUB_ID=
ADSENSE_AD_SLOT=

# Android purchase verification / Firebase
ANDROID_PACKAGE_NAME=
# Paste each service-account JSON as a single-line JSON value.
FIREBASE_SERVICE_ACCOUNT_JSON=
PLAY_SERVICE_ACCOUNT_JSON=
ANNUAL_LEAVE_FIREBASE_CREDENTIALS=
ANNUAL_LEAVE_FIREBASE_SERVICE_ACCOUNT_JSON=
